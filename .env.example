# 复制为 .env 后按需修改。所有路径相对仓库根目录。

# ── 端口与地址 ──────────────────────────────────────────
# 对外端口（server，同时托管前端）
PORT=18905
# server 监听地址：默认 0.0.0.0；放在 Caddy / Nginx 后面时设 127.0.0.1，端口就不会直接暴露到公网
# HOST=127.0.0.1
# worker 内部端口，只监听 127.0.0.1
WORKER_PORT=18915
# server ↔ worker 内部调用的共享密钥（随便一串长随机字符）
INTERNAL_SECRET=change-me-internal-secret
# 对外访问地址（鉴权回调、Cookie 用）
PUBLIC_URL=http://localhost:18905

# ── 鉴权 ───────────────────────────────────────────────
# 至少 32 位随机字符：openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32

# ── 数据目录（应用库 app.sqlite、行情仓 market.duckdb、接口缓存）──
DATA_DIR=./data

# ── LLM（实例统一 key；默认 OpenAI 兼容协议接 DeepSeek）──────
# openai-compatible | anthropic
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
# DeepSeek 的 key 形如 sk- 开头加 32 位
LLM_API_KEY=
# 对话要稳定地调工具、写合法的策略 JSON，用强一点的模型
LLM_MODEL=deepseek-v4-pro
# 夜间简报用的模型（便宜、快），留空则同 LLM_MODEL
LLM_MODEL_BRIEF=deepseek-flash

# ── 每用户每日默认额度（管理员可在后台逐人调整）──────────
QUOTA_CHAT_MESSAGES=100
QUOTA_BACKTESTS=50
# 数据查询：「复核数据」等要 worker 组装数据的读请求
QUOTA_ANALYSES=100

# ── 行情仓与回测资源（jim-server 只有约 1.2 GB 空闲内存）────
# 内存预算（worker 一个进程里全部加起来，要低于 pm2 的重启线）：
#   DUCKDB_MEMORY_LIMIT + BACKTEST_POOL_SIZE × BACKTEST_THREAD_MEMORY_MB + 约 250 MB
#   ≤ pm2 max_memory_restart − 100 MB
# 约 250 MB 是主线程、转交给回测线程的价格面板（ArrayBuffer，不受线程堆上限约束）和 DuckDB 自身开销。
# jim-server（max_memory_restart 900M）：DUCKDB_MEMORY_LIMIT=384MB、BACKTEST_POOL_SIZE=1、BACKTEST_THREAD_MEMORY_MB=160。
# 实测峰值超了先降 DUCKDB_MEMORY_LIMIT。
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
BACKTEST_POOL_SIZE=1
# 回测线程的堆上限（MB）：线程里只放结果对象，价格面板是转交的，不算在这里
BACKTEST_THREAD_MEMORY_MB=256
# 单次回测最长多久（毫秒）：超时就终止并重建线程，不让一次回测卡住当晚的结算与简报
BACKTEST_TIMEOUT_MS=120000
# 行情仓要给大表加列时，worker 启动后进维护状态、不排任务：先停 worker 跑 `pnpm ivan migrate`
# （pm2 部署用 `bash scripts/migrate.sh`，见 README「升级已有的行情仓」）。开发机可以设成 1，让 worker 启动时直接升级：
# WAREHOUSE_MIGRATE_ON_BOOT=1

# ── 抓取节奏（每个域名）──────────────────────────────────
FETCH_CONCURRENCY=4
FETCH_MIN_INTERVAL_MS=50

# ── 数据源顺序（D72）──────────────────────────────────────
# 默认按封禁风险排：日线、指数都是东财在前、腾讯在后；报价只有腾讯。一家失败、被封或没数据时自动换下一家。
# 只能重排、不能增删：写成默认集合以外的样子（多了、少了、拼错）会记日志「数据源顺序配置无效，沿用默认顺序」。
# IVAN_CHAIN_BARS_A=eastmoney,tencent
# IVAN_CHAIN_BARS_HK=eastmoney,tencent
# IVAN_CHAIN_INDEX_A=eastmoney,tencent
# IVAN_CHAIN_INDEX_HK=eastmoney,tencent
# 点时事件数据（S15，两融明细、股东户数、限售解禁、大宗交易）每个数据集一条链，本轮都只有东财，同样只能重排：
# IVAN_CHAIN_EVENTS_MARGIN=eastmoney
# IVAN_CHAIN_EVENTS_HOLDERS=eastmoney
# IVAN_CHAIN_EVENTS_LOCKUPS=eastmoney
# IVAN_CHAIN_EVENTS_BLOCKS=eastmoney
# 显式单一来源：日线与指数只用这一家、不回退（开发机 IP 被某家封禁时用）；优先于上面的顺序。auto = 按顺序回退
# KLINE_SOURCE=auto

# ── 完整性闸门（D73）────────────────────────────────────
# 夜间更新缺日线的股票太多时整晚停下、45 分钟后自动重跑。某只股票长期拿不到（数据源的问题）、又不是谁的持仓时，
# 可以在这里应急放行（逗号分隔的代码）；放行的代码记进当晚的完整性记录与之后回测的行情来源。修好后记得删掉。
# ETL_ACCEPT_MISSING=600000.SH,00700.HK

# ── 两融与筹码数据的后台回填（S15）──────────────────────
# 管理页「补齐历史数据」分段执行：每段最多多久（毫秒，默认 10 分钟），没做完 1 分钟后接着补，北京时间 16:30–21:00 暂停
# EVENTS_JOB_BUDGET_MS=600000

# 调度开关：本地开发时可设为 false，只手动跑任务
SCHEDULER_ENABLED=true
