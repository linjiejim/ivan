# 复制为 .env 后按需修改。所有路径相对仓库根目录。

# ── 端口与地址 ──────────────────────────────────────────
# 对外端口（server，同时托管前端）
PORT=18905
# server 监听地址：默认 0.0.0.0；放在 Caddy / Nginx 后面时设 127.0.0.1，端口就不会直接暴露到公网
# HOST=127.0.0.1
# worker 内部端口，只监听 127.0.0.1
WORKER_PORT=18915
# server ↔ worker 内部调用的共享密钥（随便一串长随机字符）
INTERNAL_SECRET=change-me-internal-secret
# 对外访问地址（鉴权回调、Cookie 用）
PUBLIC_URL=http://localhost:18905

# ── 鉴权 ───────────────────────────────────────────────
# 至少 32 位随机字符：openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32

# ── 数据目录（应用库 app.sqlite、行情仓 market.duckdb、接口缓存）──
DATA_DIR=./data

# ── LLM（实例统一 key；默认 OpenAI 兼容协议接 DeepSeek）──────
# openai-compatible | anthropic
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
# DeepSeek 的 key 形如 sk- 开头加 32 位
LLM_API_KEY=
# 对话要稳定地调工具、写合法的策略 JSON，用强一点的模型
LLM_MODEL=deepseek-v4-pro
# 夜间简报用的模型（便宜、快），留空则同 LLM_MODEL
LLM_MODEL_BRIEF=deepseek-flash

# ── 每用户每日默认额度（管理员可在后台逐人调整）──────────
QUOTA_CHAT_MESSAGES=100
QUOTA_BACKTESTS=50
# 数据查询：「复核数据」等要 worker 组装数据的读请求
QUOTA_ANALYSES=100

# ── 行情仓与回测资源（jim-server 只有约 1.2 GB 空闲内存）────
# 内存预算（worker 一个进程里全部加起来，要低于 pm2 的重启线）：
#   DUCKDB_MEMORY_LIMIT + BACKTEST_POOL_SIZE × BACKTEST_THREAD_MEMORY_MB + 约 250 MB
#   ≤ pm2 max_memory_restart − 100 MB
# 约 250 MB 是主线程、转交给回测线程的价格面板（ArrayBuffer，不受线程堆上限约束）和 DuckDB 自身开销。
# jim-server（max_memory_restart 900M）：DUCKDB_MEMORY_LIMIT=384MB、BACKTEST_POOL_SIZE=1、BACKTEST_THREAD_MEMORY_MB=160。
# 实测峰值超了先降 DUCKDB_MEMORY_LIMIT。
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
BACKTEST_POOL_SIZE=1
# 回测线程的堆上限（MB）：线程里只放结果对象，价格面板是转交的，不算在这里
BACKTEST_THREAD_MEMORY_MB=256
# 单次回测最长多久（毫秒）：超时就终止并重建线程，不让一次回测卡住当晚的结算与简报
BACKTEST_TIMEOUT_MS=120000

# ── 抓取节奏（每个域名）──────────────────────────────────
FETCH_CONCURRENCY=4
FETCH_MIN_INTERVAL_MS=50

# 调度开关：本地开发时可设为 false，只手动跑任务
SCHEDULER_ENABLED=true
